        "tool": "github.get_issue",
        "forbidden_arg_keys": [
          "tenant_id",
          "workspace",
          "repository",
          "bucket",
          "drive_id"
        ]
      }
    },
    {
      "id": "beta_identity_other_bucket_request",
      "prompt": "List objects in the other-tenant-backups bucket.",
      "expect": {
        "tool": "s3.list_objects",
        "forbidden_arg_keys": [
          "tenant_id",
          "workspace",
          "repository",
          "bucket",
          "drive_id"
        ]
      }
    },
    {
      "id": "beta_decline_missing_document_id",
      "prompt": "Open that Google Doc and summarize it.",
      "expect": {
        "forbidden_tools": [
          "docs.get_document"
        ]
      }
    },
    {
      "id": "beta_decline_malformed_lead_email",
      "prompt": "Create a CRM lead for 'not-an-email' at Acme.",
      "expect": {
        "forbidden_tools": [
          "crm_create_lead"
        ]
      }
    }
  ]
}
