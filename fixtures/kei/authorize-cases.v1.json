{
  "schema": "agentware.kei.authorize-cases/v1",
  "note": "Language-neutral parity table for KeiProxyEvaluator (Python, TypeScript, Go). Each case feeds a tool call through the evaluator to the fake kei-proxy (fake-kei-proxy.sh), which prints proxy.stdout / proxy.stderr and exits with proxy.exit_code. Every language must produce expected.action, a reason starting with 'kei-proxy <reason_class>', expected.rule, and exactly expected.enrollment (null = absent). No canary may appear in any decision reason or log line, and the runtime token must never appear in argv. A case may add client.expected_sha256 (see executable_pin) and proxy.symlink; expected.group_killed means the fake's backgrounded grandchild (pid in hang_pid) must be dead once the call has returned. Changing this file is a contract change: update all three languages in the same stack.",
  "policy": "policy.v1.json",
  "timeout_ms": 2000,
  "caller_defaults": {
    "span_id": "span-fixture-0001",
    "comment": "Callers are built from policy.v1.json: user_id and invoking_subject are users[input.user].id; agent_id/agent_version/framework come from agent; workspace_id from workspace. input.caller overrides user_id, parent_span and delegation_depth."
  },
  "argv_forbidden": {
    "note": "Flags no client may send. Agent identity is resolved by kei-proxy (>= 0.1.11) from the runtime installation; harnesses must omit --agent-id (kei-proxy skill). The runtime token never appears in argv (checked separately via canaries).",
    "flags": [
      "--agent-id"
    ]
  },
  "reason_classes": [
    "allow",
    "deny",
    "enrollment_required",
    "unknown_decision",
    "no_decision",
    "malformed_response",
    "empty_response",
    "proxy_error",
    "exit_mismatch",
    "proxy_unavailable",
    "proxy_timeout",
    "missing_token",
    "pin_mismatch"
  ],
  "canaries": {
    "runtime_token": "kh_fixture_CANARY_RUNTIME_TOKEN",
    "enrollment_url": "https://kei.fixture.test/identity/link#claim=CANARY-ENROLLMENT-CLAIM",
    "credential_value": "CANARY-CREDENTIAL-VALUE",
    "stderr_detail": "CANARY-STDERR-DETAIL"
  },
  "child_env": {
    "note": "The kei-proxy child sees only these parent variables (when set) plus any explicit extra env: no PATH, no HOME, nothing inherited by default. Clients resolve the executable to an absolute path in the parent and spawn that path, so the child needs no PATH. KEI_RUNTIME_VERSION is the harness-set runtime version the kei-proxy skill says the child inherits. KEI_RUNTIME_TOKEN reaches it only through the environment, never argv. KEI_PROXY_* identity variables are not inherited; identity travels as flags. Every name in stripped is set in the test parent environment and must not reach the child.",
    "allowlist": [
      "TZ",
      "KEI_RUNTIME_TOKEN",
      "KEI_RUNTIME_CONTROL_PLANE_URL",
      "KEI_RUNTIME_VERSION",
      "KEI_API_URL",
      "KEI_PROXY_REGISTRY",
      "KEI_PROXY_AUDIT",
      "KEI_PROXY_AUDIT_MAX_BYTES",
      "KEI_PROXY_PROVIDER_USER",
      "KEI_CREDENTIAL_STORE_INSTALLATION_ID",
      "KEI_AWS_SECRETS_MANAGER_ENDPOINT"
    ],
    "stripped": [
      "PATH",
      "HOME",
      "DISCORD_TOKEN",
      "OPENAI_API_KEY",
      "GITHUB_TOKEN",
      "AWS_SECRET_ACCESS_KEY",
      "KEI_PROXY_SPAN_ID"
    ]
  },
  "executable_pin": {
    "note": "Optional binary pin. When a client is configured with an expected SHA-256, then before EVERY spawn it must: require an absolute path that equals its realpath (no symlink anywhere in it), open it with O_NOFOLLOW, fstat a regular file, stream the SHA-256 from that open descriptor, and compare in constant time. Any failure denies with reason class pin_mismatch and spawns nothing. A malformed pin (not 64 hex digits) or a relative path with a pin is a construction error (Go's CLIClient has no constructor, so there every call denies with pin_mismatch). In a case, client.expected_sha256 = \"installed\" means the SHA-256 of the installed fake-kei-proxy.sh bytes; any other value is used literally. proxy.symlink = true installs the fake as kei-proxy-real and points the executable (kei-proxy) at it through a symlink; the pin is the real file's digest, so only the symlink can cause the deny. Harnesses resolve their temp directory with realpath first (macOS /var is a symlink)."
  },
  "cases": [
    {
      "id": "allow_member_read",
      "description": "Linked member reads an issue; the proxy allows (exit 0). Pins the exact argv.",
      "derived_from": "pol-read-all",
      "input": {
        "user": "member",
        "tool": "github.get_issue",
        "args": {
          "owner": "acme",
          "repo": "sales-pipeline",
          "issue_number": 42,
          "action": "github:read"
        }
      },
      "proxy": {
        "stdout": "{\"decision\":\"allow\"}\n",
        "stderr": "",
        "exit_code": 0
      },
      "expected": {
        "action": "allow",
        "rule": "kei-proxy",
        "enrollment": null,
        "reason_class": "allow",
        "invoked": true,
        "argv": [
          "authorize",
          "--user",
          "user-member-0001",
          "--tool",
          "github.get_issue",
          "--action",
          "github:read",
          "--resource",
          "github:repo:acme/sales-pipeline",
          "--span-id",
          "span-fixture-0001",
          "--invoking-subject",
          "user-member-0001",
          "--agent-version",
          "1.0.0",
          "--framework",
          "agentware",
          "--tool-args-digest",
          "7ed161e4e3b1613f53bbf8de4b03ff63e5fc7938b64232034e6bd2088d8e1153",
          "--resources",
          "github:repo:acme/sales-pipeline,github:issue:42"
        ]
      }
    },
