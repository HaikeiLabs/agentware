{
  "schema": "kei.tool-manifest/v3",
  "tools": [
    {
      "name": "github.get_issue",
      "service": "github",
      "source": "github",
      "operation_class": "read",
      "route": {
        "connector_binding": {
          "agent_id": "11111111-1111-4111-8111-111111111111",
          "connector_id": "22222222-2222-4222-8222-222222222222"
        }
      },
      "required_capabilities": [
        "issue.read",
        "repository.read"
      ],
      "resource_types": [
        {
          "type": "issue",
          "parent_type": "repository"
        },
        {
          "type": "repository"
        }
      ],
      "description": "Fetch an issue from a GitHub repository",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {
          "issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "repository": {
            "type": "string"
          }
        },
        "required": [
          "issue_number",
          "repository"
        ]
      }
    }
  ]
}
