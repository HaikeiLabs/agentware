{
  "schema": "kei.tool-manifest/v3",
  "tools": [
    {
      "name": "codex.shell",
      "service": "codex",
      "source": "codex",
      "operation_class": "write",
      "route": {
        "harness_executor": {
          "executor": "codex",
          "registration": "codex.shell"
        }
      },
      "description": "Run a local harness action",
      "enabled": true
    },
    {
      "name": "github.get_issue",
      "service": "github",
      "source": "github",
      "operation_class": "read",
      "route": {
        "connector_binding": {
          "agent_id": "11111111-1111-4111-8111-111111111111",
          "connector_id": "22222222-2222-4222-8222-222222222222"
        }
      },
      "required_capabilities": [
        "issue.read"
      ],
      "resource_types": [
        {
          "type": "issue",
          "parent_type": "repository"
        }
      ],
      "description": "Fetch an issue from a GitHub repository",
      "enabled": true
    },
    {
      "name": "linear.update_issue",
      "service": "linear",
      "source": "linear",
      "operation_class": "write",
      "route": {
        "connector_binding": {
          "agent_id": "11111111-1111-4111-8111-111111111111",
          "connector_id": "22222222-2222-4222-8222-222222222222"
        }
      },
      "required_capabilities": [
        "issue.write"
      ],
      "resource_types": [
        {
          "type": "issue",
          "parent_type": "team"
        }
      ],
      "description": "Update a Linear issue",
      "enabled": false
    }
  ]
}
