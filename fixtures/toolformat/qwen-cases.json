{
  "family": "qwen",
  "description": "Qwen XML tool-call format (<tool_call>...</tool_call>)",
  "format_definitions": [
    {
      "name": "two tools",
      "expected": "# Tools\n\nYou may call one or more functions to assist with the user query.\n\nYou are provided with function signatures within <tools></tools> XML tags:\n<tools>\n{\"function\":{\"description\":\"Get current weather for a location\",\"name\":\"get_weather\",\"parameters\":{\"properties\":{\"location\":{\"description\":\"City name, e.g. 'Tokyo'\",\"type\":\"string\"},\"unit\":{\"default\":\"celsius\",\"enum\":[\"celsius\",\"fahrenheit\"],\"type\":\"string\"}},\"required\":[\"location\"],\"type\":\"object\"}},\"type\":\"function\"}\n{\"function\":{\"description\":\"Search the web for information\",\"name\":\"search_web\",\"parameters\":{\"properties\":{\"query\":{\"description\":\"Search query\",\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"}},\"type\":\"function\"}\n</tools>\n\nFor each function call, return a json object with function name and arguments within <tool_call></tool_call> XML tags:\n<tool_call>\n{\"name\": <function-name>, \"arguments\": <args-json-object>}\n</tool_call>"
    }
  ],
  "parse_calls": [
    {
      "name": "single call",
      "input": "<tool_call><tool name=\"get_weather\">{\"location\":\"Tokyo\",\"unit\":\"celsius\"}</tool></tool_call>",
      "expected": [
        {
          "name": "get_weather",
          "args": {
            "location": "Tokyo",
            "unit": "celsius"
          }
        }
      ],
      "deprecated_since": "next minor release"
    },
    {
      "name": "multiple calls",
      "input": "<tool_call><tool name=\"get_weather\">{\"location\":\"Paris\"}</tool></tool_call><tool_call><tool name=\"search_web\">{\"query\":\"forecast\"}</tool></tool_call>",
      "expected": [
        {
          "name": "get_weather",
          "args": {
            "location": "Paris"
          }
        },
        {
          "name": "search_web",
          "args": {
            "query": "forecast"
          }
        }
      ],
      "deprecated_since": "next minor release"
    },
    {
      "name": "empty response",
      "input": "",
      "expected": []
    },
    {
      "name": "no tool calls",
      "input": "Let me check the weather.",
      "expected": []
    },
    {
      "name": "hermes_qwen3_real",
      "input": "\u003cthink>I need Tokyo's weather.\u003c/think>\n\n<tool_call>\n{\"name\": \"get_weather\", \"arguments\": {\"city\": \"Tokyo\"}}\n</tool_call><|im_end|>",
      "expected": [
        {
          "name": "get_weather",
          "args": {
            "city": "Tokyo"
          }
        }
      ]
    },
    {
      "name": "hermes multiple and string arguments",
      "input": "<tool_call>\n{\"name\":\"first\",\"arguments\":{\"x\":1}}\n</tool_call><tool_call>{\"name\":\"second\",\"arguments\":\"{\\\"y\\\":2}\"}</tool_call>",
      "expected": [
        {
          "name": "first",
          "args": {
            "x": 1
          }
        },
        {
          "name": "second",
          "args": {
            "y": 2
          }
        }
      ]
    }
  ],
  "format_result": [
    {
      "name": "success",
      "tool_name": "get_weather",
      "result": {
        "success": true,
        "output": "Sunny, 22°C"
      },
      "expected": "<tool_response>\nSunny, 22°C\n</tool_response>"
    },
    {
      "name": "error",
      "tool_name": "get_weather",
      "result": {
        "success": false,
        "error": "API unavailable"
      },
      "expected": "<tool_response>\n{\"error\":\"API unavailable\"}\n</tool_response>"
    },
    {
      "name": "string that looks like JSON stays verbatim",
      "tool_name": "get_weather",
      "result": {"success": true, "output": "{\"temp\":22}"},
      "expected": "<tool_response>\n{\"temp\":22}\n</tool_response>"
    },
    {
      "name": "dict result is compact JSON in key order",
      "tool_name": "get_weather",
      "result": {"success": true, "output": {"temp": 22, "sky": "rain", "note": "22°C"}},
      "expected": "<tool_response>\n{\"temp\":22,\"sky\":\"rain\",\"note\":\"22°C\"}\n</tool_response>"
    },
    {
      "name": "list result is compact JSON",
      "tool_name": "get_weather",
      "result": {"success": true, "output": [1, "a", true, null]},
      "expected": "<tool_response>\n[1,\"a\",true,null]\n</tool_response>"
    },
    {
      "name": "number result is JSON",
      "tool_name": "get_weather",
      "result": {"success": true, "output": 22.5},
      "expected": "<tool_response>\n22.5\n</tool_response>"
    },
    {
      "name": "boolean result is JSON",
      "tool_name": "get_weather",
      "result": {"success": true, "output": false},
      "expected": "<tool_response>\nfalse\n</tool_response>"
    }
  ],
  "validate_format": [
    {
      "name": "valid",
      "input": "<tool_call><tool name=\"get_weather\">{}</tool></tool_call>",
      "valid": true,
      "deprecated_since": "next minor release"
    },
    {
      "name": "empty",
      "input": "",
      "valid": true
    },
    {
      "name": "missing name attr",
      "input": "<tool_call><tool>{}</tool></tool_call>",
      "valid": false,
      "deprecated_since": "next minor release"
    },
    {
      "name": "malformed JSON args",
      "input": "<tool_call><tool name=\"get_weather\">{bad}</tool></tool_call>",
      "valid": false,
      "deprecated_since": "next minor release"
    },
    {
      "name": "hermes valid",
      "input": "<tool_call>{\"name\":\"f\",\"arguments\":{}}</tool_call>",
      "valid": true
    },
    {
      "name": "hermes malformed JSON",
      "input": "<tool_call>{bad}</tool_call>",
      "valid": false
    },
    {
      "name": "hermes malformed string arguments",
      "input": "<tool_call>{\"name\":\"f\",\"arguments\":\"bad\"}</tool_call>",
      "valid": false
    }
  ]
}
