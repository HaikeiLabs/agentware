{
  "suite": {
    "schema": "agentware.eval-suite.v1",
    "suite": "conformance.suite-v1.bad-regex",
    "kind": "agent",
    "system_prompt": "You file bugs.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "file_bug",
          "description": "File a bug report.",
          "parameters": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      }
    ],
    "cases": [
      {
        "id": "bad-regex",
        "prompt": "Do something.",
        "expect": {
          "tool": "file_bug",
          "content": {
            "regex": [
              "kei-\\d+["
            ]
          }
        }
      }
    ]
  },
  "error_contains": "invalid regex"
}
