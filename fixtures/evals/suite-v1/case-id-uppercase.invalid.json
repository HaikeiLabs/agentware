{
  "suite": {
    "schema": "agentware.eval-suite.v1",
    "suite": "conformance.suite-v1.case-id-uppercase",
    "kind": "agent",
    "system_prompt": "You file bugs.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "file_bug",
          "description": "File a bug report.",
          "parameters": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      }
    ],
    "cases": [
      {
        "id": "Case-1",
        "prompt": "Do something.",
        "expect": {
          "tool": "file_bug"
        }
      }
    ]
  },
  "error_contains": "must match ^[a-z0-9][a-z0-9._-]{0,63}$"
}
